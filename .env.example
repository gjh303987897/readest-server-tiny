# Docker Compose image/build settings. Override the three base images when
# Docker Hub is unavailable; use a registry you trust.
READEST_IMAGE=readest-tiny-backend:latest
NODE_IMAGE=node:24-alpine
GO_IMAGE=golang:1.25-alpine
ALPINE_IMAGE=alpine:3.21
GOPROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmmirror.com
BIND_HOST=127.0.0.1
PORT=8080

# Public address used in runtime config, JWT issuer checks, email links, and signed URLs.
# Production deployments must use HTTPS (normally through a reverse proxy).
APP_ENV=development
ADDR=127.0.0.1:8080
PUBLIC_URL=http://127.0.0.1:8080

# This value is public and is returned to Readest. It is an API identifier, not a secret.
PUBLIC_ANON_KEY=readest-public-anon-key

# The first start creates this administrator if the database has no admin.
# Leave the password empty to generate it in DATA_DIR/initial-admin-credentials.json.
INITIAL_ADMIN_EMAIL=admin@readest.local
INITIAL_ADMIN_PASSWORD=

# Optional. When empty, a 384-bit key is generated once in DATA_DIR/jwt-secret.
JWT_SECRET=

DATA_DIR=./data
DATABASE_DSN=./data/readest.db
STORAGE_DIR=./data/objects

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SIGNED_URL_TTL=30m
STORAGE_QUOTA_BYTES=524288000
MAX_UPLOAD_BYTES=524288000
MAX_JSON_BODY_BYTES=2097152
# Maximum encrypted download size and total extracted database/object bytes (50 GiB).
# Backups require additional local disk space and approximately 256 MiB for scrypt.
BACKUP_MAX_BYTES=53687091200
BACKUP_TIMEOUT=2h
HTTP_IO_TIMEOUT=30m
SHUTDOWN_TIMEOUT=10s
BCRYPT_COST=12

# Wildcard CORS is acceptable here because authentication is Bearer-token based and
# the server does not use ambient cookies. Restrict this list for a web-only deployment.
CORS_ALLOWED_ORIGINS=*
ALLOWED_REDIRECT_URLS=http://localhost:3000,readest://auth-callback
AUTH_RATE_LIMIT_PER_MINUTE=30
API_RATE_LIMIT_PER_MINUTE=300

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
